{
  "name": "@red-cup-engineering/linux-cloudflare-authentication-service",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Initiates one explicitly scoped Cloudflare OAuth authorization from a Linux settlement, stores it through Wrangler named-profile keyring custody, verifies the account binding, and returns a non-secret receipt.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/cloudflare-engineering-services-section.git",
    "directory": "services/linux-cloudflare-authentication-service"
  },
  "homepage": "https://linux-cloudflare-authentication.actions.561.group/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "authenticate-linux-colony-with-cloudflare": "./scripts/authenticate-linux-colony-with-cloudflare.mjs"
  },
  "exports": {
    ".": "./src/authenticate-linux-colony-with-cloudflare.mjs",
    "./keyring-substrate": "./src/wrangler-keyring-authority-substrate.mjs",
    "./libexec/secret-tool": "./libexec/secret-tool"
  },
  "files": [
    "scripts",
    "content",
    "libexec",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check scripts/authenticate-linux-colony-with-cloudflare.mjs && node --check src/authenticate-linux-colony-with-cloudflare.mjs && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@red-cup-engineering/cbor-engineering-services-section": "^0.1.1",
    "@red-cup-engineering/cryptographic-computer-data-engineering-services-section": "^0.3.3",
    "@red-cup-engineering/computer-file-engineering-services-section": "^0.8.4",
    "@red-cup-engineering/http-engineering-services-section": "^0.6.5-dev.2",
    "wrangler": "^4.114.0",
    "@red-cup-engineering/computer-content-address-engineering-services-section": "^0.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
